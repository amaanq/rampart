# Ignore everything; whitelist real project files explicitly.
*

# Top-level
!.editorconfig
!.envrc
!.gitignore
!.rustfmt.toml
!.taplo.toml
!Cargo.lock
!Cargo.toml
!README.md
!cornucopia.toml
!deny.toml
!flake.lock
!flake.nix
!rust-toolchain.toml

# Cargo config + CI
!.cargo/
!.cargo/**
!.github/
!.github/**

# Tack-managed Nix inputs
!.tack/
!.tack/default.nix
!.tack/pins.toml
!.tack/pins.lock.json

# Source
!src/
!src/**

# Tests
!tests/
!tests/**

# Schema + queries
!migrations/
!migrations/**
!queries/
!queries/**

# Cornucopia-generated codegen — committed for reproducible builds.
# target/ and Cargo.lock inside stay out via the "*" default.
!db/
!db/rampart-codegen/
!db/rampart-codegen/Cargo.toml
!db/rampart-codegen/src/
!db/rampart-codegen/src/**

# Static + templates
!static/
!static/**
!templates/
!templates/**

# Browser extension
!extension/
!extension/**
extension/dist/

# Nix + deploy
!nix/
!nix/**

# Docs + scripts
!docs/
!docs/**
!scripts/
!scripts/**
